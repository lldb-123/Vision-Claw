* text=auto
*.md text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Preserve source documents, drawings and ready-to-flash images byte for byte.
*.pdf -text
*.doc -text
*.xlsx -text
*.png -text
*.schdoc binary
*.pcbdoc binary
*.SLDPRT -text
*.sldprt -text
*.SLDASM -text
*.bin -text

# Keep the single canonical midterm dataset and model weights outside Git blobs.
midterm-vision/dataset/images/*.png filter=lfs diff=lfs merge=lfs -text
midterm-vision/dataset/images/*.json -text -diff
midterm-vision/weights/*.pt filter=lfs diff=lfs merge=lfs -text
